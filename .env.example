# Copia este archivo a ".env" y completa los valores. Nunca subas ".env" al repositorio.

# Puerto del servidor
PORT=3000

# Contraseña para entrar a la app (obligatoria si la publicas en internet)
APP_PASSWORD=

# --- Sincronización automática con Tradovate (opcional) ---
# Requiere el complemento "API Access" activo en tu cuenta de Tradovate.
TRADOVATE_ENV=live            # live | demo
TRADOVATE_USER=
TRADOVATE_PASSWORD=
TRADOVATE_CID=                # "cid" de tu clave de API
TRADOVATE_SEC=                # "secret" de tu clave de API
TRADOVATE_APP_ID=DiarioDeTrading
SYNC_MINUTES=5                # cada cuántos minutos sincroniza
